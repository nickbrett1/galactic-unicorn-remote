# Environment variables for galactic-unicorn-remote (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.
#
# NEVER put a real value in this file — it is committed. The device token lives in
# Doppler (common/dev locally, common/prd for CI) and is injected as an
# environment value on the NAS (implementation-considerations §7.5).

# Shared LAN-only device token (/device/poll). Required in any non-dev run; the
# service fails fast if it is unset. Leave blank here.
DEVICE_TOKEN=

# Pending-desired TTL in seconds (O6, recommended 45). Optional; default 45.
DESIRED_TTL_S=45

# Offline threshold in seconds behind `panel.online` (O4, recommended 15). Optional.
OFFLINE_THRESHOLD_S=15

# Server-side `next_poll_ms` clamp bounds (O5, recommended 1000 / 10000). Optional.
NEXT_POLL_MIN_MS=1000
NEXT_POLL_MAX_MS=10000

# Append-only JSONL audit log destination (O1). Optional; default data/audit.jsonl.
AUDIT_LOG_PATH=data/audit.jsonl
