{
  "name": "galactic-unicorn-remote",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prepare": "simple-git-hooks",
    "test": "vitest --coverage",
    "test:once": "npx vitest run --changed",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check",
    "check:watch": "svelte-kit sync && svelte-check --watch",
    "lint": "prettier --check . && eslint ."
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "**/*.{js,ts,svelte,json,css,html,md}": "prettier --write --ignore-unknown",
    "**/*.{js,ts,svelte}": "eslint --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "npm@11.19.1",
  "engines": {
    "npm": ">=11 <12"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.53.8",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "@sveltejs/adapter-node": "^5.4.2",
    "vitest": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.11",
    "@testing-library/svelte": "^5.2.0",
    "@testing-library/jest-dom": "^6.6.0",
    "jsdom": "^25.0.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "lint-staged": "^16.4.0"
  },
  "overrides": {
    "cookie": "^1.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "vite": "^8.2.2"
  }
}
