# cloudflared tunnel token — copy to cloudflared.env (mode 600) and paste the
# token the Cloudflare dashboard gives you when you create the tunnel
# (Zero Trust → Networks → Tunnels → Create → Docker). Never commit the real
# value; it is a credential for the tunnel, not just an identifier.
#
# The same env var is what `docker compose -f cloudflared.compose.yml` reads:
#   TUNNEL_TOKEN=
TUNNEL_TOKEN=
